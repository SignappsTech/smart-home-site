# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and set the endpoint your contact form POSTs
# to (e.g. Formspree, Web3Forms, Getform). Until it's set, the form shows a
# fallback message instead of submitting. NEXT_PUBLIC_ prefix = exposed to the
# browser, which a static-export client form requires.
NEXT_PUBLIC_FORM_ENDPOINT=

# ---------------------------------------------------------------------------
# Google Analytics 4 (only active in production builds, or with NEXT_PUBLIC_GA_DEBUG=1)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-X87M51PC9X
# First-party proxy (workers/ga-proxy), incl. path prefix, no trailing slash.
# Leave empty to send hits straight to Google. e.g. https://stats.signapps.si/m
NEXT_PUBLIC_GA_PROXY_URL=
# Set to 1 to enable GA in 'next dev' for testing.
NEXT_PUBLIC_GA_DEBUG=
